    `status`                                    INT(11)         NOT NULL DEFAULT 1,
    `insertdatetime`                            DATETIME        NULL,
    `updatedatetime`                            DATETIME        NULL,
    `tbl_user_idtbl_user`                       INT(11)         NOT NULL,
    `tbl_material_info_idtbl_material_info`     INT(11)         NOT NULL,
    `tbl_supplier_porder_idtbl_supplier_porder` INT(11)         NOT NULL,
    PRIMARY KEY (`idtbl_supplier_porder_detail`),
    INDEX `fk_spod_user_idx`     (`tbl_user_idtbl_user`),
    INDEX `fk_spod_material_idx` (`tbl_material_info_idtbl_material_info`),
